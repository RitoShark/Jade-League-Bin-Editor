{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jade",
  "version": "0.9.0",
  "identifier": "com.emirf.jade-rust",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:42067",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jade",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "budlibu500",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsi"
      }
    },
    "fileAssociations": [
      {
        "ext": ["bin"],
        "name": "Jade League Bin File",
        "description": "League of Legends BIN data file",
        "role": "Editor"
      },
      {
        "ext": ["troybin", "inibin"],
        "name": "Jade Troybin Source",
        "description": "Legacy League VFX source file",
        "role": "Editor"
      }
    ]
  }
}
